VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend (server-side only — used by Supabase Edge Functions, never expose as VITE_*)
RESEND_API_KEY=
# "From" address on outgoing mail — must be a Resend-verified domain (NOT a Gmail inbox).
# Use onboarding@resend.dev only for testing. Production: bookings@yourdomain.com after domain verify.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where the clinic receives new booking alerts (your Gmail is correct here)
ADMIN_NOTIFICATION_EMAIL=
# Where patient replies go when they hit Reply
CLINIC_REPLY_TO_EMAIL=

# Supabase service role (edge function only — never expose as VITE_*)
SUPABASE_SERVICE_ROLE_KEY=
